{
  "name": "penantumbra-studio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "penantumbra.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
